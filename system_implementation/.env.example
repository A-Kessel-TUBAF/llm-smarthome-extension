# Copy to .env (same folder) and fill in. 
# .env is git-ignored.

# Local (default)
# LLM_MODEL=ollama:gemma2

############################################

# GWDG Chat AI (OpenAI-compatible)
# LLM_MODEL=openai:meta-llama-3.1-8b-instruct
# OPENAI_BASE_URL=https://chat-ai.academiccloud.de/v1
# OPENAI_API_KEY=<your Chat AI key>

##################################################

# Any OpenAI-compatible service (GWDG Chat AI, OpenRouter, Groq, vLLM on HPC, ...):
# LLM_MODEL=openai:google/gemma-2-9b-it
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=...

############################################
# OpenAI
# LLM_MODEL=openai:gpt-4o-mini
# OPENAI_API_KEY=sk-...

############################################

# Anthropic
# LLM_MODEL=anthropic:claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...

